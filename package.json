{
  "name": "pyapy",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/mobile",
    "packages/contracts"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "db:backup": "node scripts/backup.mjs",
    "db:verify-restore": "node scripts/backup.mjs --verify",
    "report": "node scripts/report.mjs",
    "mobile:check": "npm exec --workspace=mobile -- expo install --check",
    "mobile:export": "npm exec --workspace=mobile -- expo export --platform android --platform ios",
    "format": "prettier --write apps packages scripts tests eslint.config.js playwright.config.js package.json",
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev -w @pyapy/api",
    "dev:web": "npm run dev -w @pyapy/web",
    "db:local": "node scripts/local-db.mjs",
    "db:migrate": "node apps/api/src/migrate.mjs",
    "db:seed": "node apps/api/src/seed.mjs",
    "build": "npm run build -w @pyapy/web",
    "lint": "eslint apps packages scripts tests",
    "test": "node scripts/test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "prettier": "3.9.7",
    "supertest": "7.2.2"
  }
}
