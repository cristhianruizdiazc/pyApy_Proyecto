# pyApy Environment Variables Template
# Copy this file to .env and provide your production credentials.
# NEVER commit real credentials to version control.

# --- DEVELOPMENT SECRETS (Only active when NODE_ENV !== 'production') ---
# If left empty in development, dev auth endpoints remain completely disabled.
# In production (NODE_ENV=production), dev auth endpoints are permanently disabled regardless of these values.
DEV_ADMIN_SECRET=
DEV_OWNER_SECRET=

# Firebase Admin SDK (Server-Side - Production & Staging)
SERVER_FIREBASE_PROJECT_ID=
SERVER_FIREBASE_CLIENT_EMAIL=
SERVER_FIREBASE_PRIVATE_KEY=

# Optional: Firestore Emulator for local testing
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# --- CLIENT-SIDE CONFIGURATION (Vite / Browser) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
