NODE_ENV=development
PORT=4100
HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:5173
# Run npm run db:local to create isolated local credentials in .env.
DATABASE_URL=postgresql://pyapy:REPLACE_LOCALLY@127.0.0.1:55432/pyapy
DEMO_MODE=true
UPLOAD_DIR=.local/uploads
# Optional JSON; server validates keys and bounds. See ADR-012 for all limits.
SEARCH_CONFIG={"radiiKm":[15,30,50],"maxOverpricePercent":20,"alternatives":6,"windowDays":7,"maxIntervals":6,"maxProbes":168,"stepHours":1,"timeoutMs":5000,"maxQueries":5}
